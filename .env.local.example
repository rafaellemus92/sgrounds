# Local development env.
#
# Copy this file to `.env.local` and fill in the values from your Supabase
# project. The piano trainer and the sgrounds app both read from the same
# two public vars.
#
# Find these at:  https://supabase.com/dashboard/project/_/settings/api
#   - Project URL          → NEXT_PUBLIC_SUPABASE_URL
#   - anon / public key    → NEXT_PUBLIC_SUPABASE_ANON_KEY

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
